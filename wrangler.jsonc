{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rettohighlight-gemini",
  "main": "src/cloudflare/aiProxy.worker.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "placement": {
    "region": "gcp:asia-southeast1"
  },
  "vars": {
    "CANDIDATE_INSIGHT_PROVIDER": "qwen",
    "BROADCAST_CONTEXT_PROVIDER": "qwen",
    "BROADCAST_TRANSCRIPT_PROVIDER": "qwen",
    "BROADCAST_TRANSCRIPT_TRANSPORT_MODE": "free-r2",
    "AI_PROVIDER_FALLBACK_MODE": "bounded",
    "AI_QUOTA_MODE": "required",
    "QWEN_REGION": "singapore"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA_COORDINATOR",
        "class_name": "AiQuotaCoordinator"
      }
    ]
  },
  "exports": {
    "AiQuotaCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "TRANSCRIPT_MEDIA",
      "bucket_name": "exclipper-transcript-media"
    }
  ],
  "secrets": {
    // Optional Groq route: inject GROQ_API_KEY with `wrangler secret put`
    // only when BROADCAST_TRANSCRIPT_PROVIDER is explicitly set to "groq".
    "required": [
      "GEMINI_API_KEY",
      "QWEN_API_KEY",
      "TRANSCRIPT_MEDIA_SIGNING_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "20260720",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "20260721",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CONTEXT_RATE_LIMITER",
      "namespace_id": "20260722",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "CONTEXT_IP_RATE_LIMITER",
      "namespace_id": "20260723",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
